---
import TextAnimation from "./TextAnimation.astro";
const { href = "", imgSrc, title, desc } = Astro.props;
---

<a href={href} target="_blank" rel="noreferrer noopener">
    <div class="imageContainer">
        <img id="backgroundImage" src={imgSrc} />
    </div>
    <div class="reservationContent">
        <div>
            <TextAnimation once text={title} className="header" />
            <p>
                { desc }
            </p>
        </div>
    </div>
</a>

<script>
    import { animate, stagger, inView } from "motion";
    inView("#textContainer", () => {
        animate("span", { opacity: 1, y: [10, 0] }, { delay: stagger(0.1) });
    });
</script>

<style>
    .reservationContent {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex-grow: 1;
        margin-top: 1rem;
    }

    .reservationContent > p {
        color: var(--foreground-muted);
    }

    .imageContainer {
        aspect-ratio: 16/9;
        position: relative;
        width: 100%;
    }

    a {
        color: var(--foreground);
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
        padding-left: 1rem;
        padding-right: 1rem;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        background-color: var(--foreground-muted-opaque);
        border-radius: 0.75rem;
        width: 100%;
        height: 100%;
    }

    a:hover {
        transform: scale(1.02);
        background-color: var(--foreground-muted-opaque);
    }

    #backgroundImage {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; /* makes it behave like background-size: cover */
        object-position: center; /* keeps it centered */
        z-index: 10;
    }

    @media screen and (min-width: 768px) {
        a {
        width: min-content;
    }
        .imageContainer {
            width: 400px;
        }
    }
</style>
