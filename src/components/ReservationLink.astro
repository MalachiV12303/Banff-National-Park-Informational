---
import TextAnimation from "./TextAnimation.astro";
const { href = "", imgSrc, title, desc } = Astro.props;
---

<a href={href} target="_blank" rel="noreferrer noopener">
    <div class="imageContainer">
        <img id="backgroundImage" src={imgSrc} />
    </div>
    <div class="reservationContent">
        <div>
            <TextAnimation once text={title} className="header" />
            <p>
                Banff National Park is located in the province of Alberta in the
                Canadian Rocky Mountains. It is situated 128 km (80 miles) west
                of Calgary, 401 km (250 miles) southwest of Edmonton and 850 km
                (500 miles) northeast of Vancouver. Home to glacial lakes and
                stunning mountain peaks, it's no wonder Banff National Park is
                an adventure seekers paradise! It's essential to plan ahead
                before visiting Banff National Park.
            </p>
        </div>
    </div>
</a>

<script>
    import { animate, stagger, inView } from "motion";
    inView("#textContainer", () => {
        animate("span", { opacity: 1, y: [10, 0] }, { delay: stagger(0.1) });
    });
</script>

<style>
    .reservationContent {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex-grow: 1;
        margin-top: 1rem;
    }

    .reservationContent > p {
        color: var(--foreground-muted);
    }

    .imageContainer {
        aspect-ratio: 16/9;
        position: relative;
        width: 100%;
    }

    a {
        color: var(--foreground);
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
        padding-left: 1rem;
        padding-right: 1rem;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        background-color: var(--foreground-muted-opaque);
        border-radius: 0.75rem;
        width: 100%;
    }

    a:hover {
        transform: scale(1.02);
        background-color: var(--foreground-muted-opaque);
    }

    #backgroundImage {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; /* makes it behave like background-size: cover */
        object-position: center; /* keeps it centered */
        z-index: 10;
    }

    @media screen and (min-width: 768px) {
        a {
        width: min-content;
    }
        .imageContainer {
            width: 500px;
        }
    }

    /* @media screen and (min-width: 1024px) {
        .imageContainer {
            width: 500px;
        }
    } */
</style>
