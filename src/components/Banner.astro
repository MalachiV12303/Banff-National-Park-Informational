---
import imageBackground from "../assets/banner.jpg";
import { Image } from "astro:assets";
import Typewriter from "astro-typewriter";
---

<section>
	<Image
		src={imageBackground}
		width={3840}
		height={2160}
		id="backgroundImage"
		alt={"placeholder"}
	/>
	<div class="container">
		<div id="bannerContent">
			<h1 class="mono">Canada's First National Park</h1>
			<p class="bind">
				Rocky Mountain peaks, turquoise glacial lakes, a picture-perfect
				mountain town and village, abundant wildlife and scenic drives
				come together in Banff National Park - Canada's first national
				park and the flagship of the nation's park system.
			</p>
			<p class="bind">
				Vibrant lakes, majestic mountains and easy access to outdoor
				adventures of all kinds.
			</p>
		</div>
	</div>
</section>

<script>
	import { animate, inView } from "motion";
		inView(
		"#bannerContent", // scope: this element
		(element: Element) => {
			animate(
				element,
				{ opacity: [0, 1] }, // fade + slide up
				{ duration: 2, easing: "ease-in-out" },
			);
		},
		{
			amount: "some", // require fully in view
			margin: "0px 0px -40% 0px", // add margins
			once: true, // only animate the first time
		},
	);
</script>

<style>
	#bannerContent {
		opacity: 0;
	}

	.bind {
		max-width: 40rem;
	}

	section {
		position: relative;
		min-height: fit-content;
		color: #fcfcfc;
	}

	h1 {
		font-size: var(--text-2xl);
		letter-spacing: 1px;
	}

	p {
		font-size: var(--text-lg);
		margin-top: 1rem;
	}

	#backgroundImage {
		position: absolute;
		filter: brightness(50%);
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover; /* makes it behave like background-size: cover */
		object-position: center; /* keeps it centered */
		z-index: -5;
	}

	/* targets devices width > 640 */
	@media screen and (min-width: 640px) {
		section {
			align-items: start;
			min-height: 100vh;
		}
	}
</style>
