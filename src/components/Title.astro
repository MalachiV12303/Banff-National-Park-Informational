---
import { Image } from "astro:assets";
import imageBackground from "../assets/banffTitle1.jpg";
import imageBackground2 from "../assets/banffTitle2.jpg";

const { topWord, bottomWord, imageSelect = true } = Astro.props;
---

<section>
	<Image
		src={imageSelect ? imageBackground : imageBackground2}
		width={3840}
		height={2160}
		id="parallaxTitleImage"
		alt={"placeholder"}
	/>
	<div>
		<h2 id="titleContent">
			<span class="mono" id="top">
				{topWord}
			</span>
			<span class="mono" id="bot">
				{bottomWord}
			</span>
		</h2>
	</div>
</section>

<script>
	import { animate, inView, scroll } from "motion";
	inView(
		"#titleContent", // scope: this element
		(element: Element) => {
			animate(
				element,
				{ opacity: [0, 1] }, // fade + slide up
				{ duration: 2, easing: "ease-in-out" },
			);
		},
		{
			amount: "some", // require fully in view
			margin: "0px 0px -50% 0px", // add margins
			once: true, // only animate the first time
		},
	);

	document
		.querySelectorAll("section > #parallaxTitleImage")
		.forEach((item) => {
			scroll(animate(item, { y: [-300, 0, 300] }), {
				target: item,
				offset: ["start end", "end end", "end start"],
			});
		});
</script>

<style>
	section {
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
		color: #f7f7f7;
	}

	#titleContent {
		opacity: 0;
	}

	#parallaxTitleImage {
		position: absolute;
		z-index: -5;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	#top,
	#bot {
		filter: drop-shadow(0 4px 4px rgb(0 0 0 / 0.6));
		text-transform: uppercase;
		display: block;
		text-align: center;
	}

	#top {
		font-size: var(--text-xl);
		letter-spacing: var(--text-sm);
	}

	#bot {
		font-size: var(--text-3xl);
		letter-spacing: normal;
	}

	@media screen and (max-width: 640px) {
		#top {
			font-size: var(--text-lg);
		}

		#bot {
			font-size: 4rem;
		}
	}
</style>
