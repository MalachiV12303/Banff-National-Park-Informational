---
const { text = 'example text', className } = Astro.props;
---
<h1 class={`${className} mono`} id="textContainer">
	{text.split(' ').map((word: string)=>(
        <span>
            {word.split('').map((char)=>(
                <span class="mono">{char}</span>
            ))}
        </span>
        <span/>
    ))}
</h1>

<script>
    import { animate, stagger, inView } from 'motion';
    inView("#textContainer", () => {
        animate('span', { opacity: 1, y: [10, 0] }, {delay: stagger(0.1)});
	});
</script>

<style>
    .header {
		font-size: var(--text-xl);
		white-space: nowrap;
	}

    span{
        opacity: 0;
        display: inline-block;
    }
</style>
