---
import ReservationLink from "./ReservationLink.astro";
---

<section>
	<div class="container">
		<h2 class="headerText mono" id="reservationsContent">Reservations</h2>
		<ul>
			<li id="reservationsContent">
				<ReservationLink
					href="https://parks.canada.ca/pn-np/ab/banff/activ/camping"
					title="Banff National Park"
					imgSrc="/banffLink.avif"
					desc="Banff National Park is located in the province of Alberta in the Canadian Rocky Mountains. It is situated 128 km (80 miles) west of Calgary, 401 km (250 miles) southwest of Edmonton and 850 km (500 miles) northeast of Vancouver. Home to glacial lakes and stunning mountain peaks, it's no wonder Banff National Park is an adventure seekers paradise! It's essential to plan ahead before visiting Banff National Park."
				/>
			</li>
			<li id="reservationsContent">
				<ReservationLink
					href="https://parks.canada.ca/pn-np/ab/banff/visit/parkbus/louise"
					title="Lake Louise"
					imgSrc="/lakeLink.jpg"
					desc="Choose from multiple service options to Banff and Lake Louise with ABest Transport and Tour Services, Alpine Limousine & Tours, Banff Airporter, Banff Sedan, Brewster Express, Discover Banff Tours, Mountain Park Transportation and Banff Chauffeur. Prices vary and booking is required."
				/>
			</li>
		</ul>
	</div>
</section>

<script>
	import { animate, inView } from "motion";
		inView(
		"#reservationsContent", // scope: this element
		(element: Element) => {
			animate(
				element,
				{ opacity: [0, 1] }, // fade + slide up
				{ duration: 2, easing: "ease-in-out" },
			);
		},
		{
			amount: "some", // require fully in view
			margin: "0px 0px -40% 0px", // add margins
			once: true, // only animate the first time
		},
	);
</script>

<style>
	#reservationsContent{
		opacity: 0;
	}
	
	.headerText {
		font-size: var(--text-2xl);
		margin-bottom: 4rem;
		text-align: center;
	}

	ul {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
		gap: 4rem;
	}

	/* targets devices width > 640 */
	@media screen and (min-width: 768px) {
		ul {
			flex-direction: row;
		}
	}
	@media screen and (min-width: 768px) {
		ul {
			flex-direction: row;
		}
	}
</style>
