---
import MyLogo from "../assets/downArrow.svg";
---

<a href="#landing"  class="mono">
    <div id="toTop">
        <MyLogo id="rotate" width={40} height={40} />
    </div>
</a>

<script>
    import { animate } from "motion";
    animate(
        "#toTop",
        { y: [-8, 0, -8] },
        { repeat: Infinity, repeatType: "loop", duration: 1.5 },
    );
</script>

<style scoped>
    a {
        background-color: transparent;
        color: var(--foreground);
        transition: 0.2s all ease-in-out;
        font-size: var(--text-lg);
        text-decoration: none;
        margin-left: auto;
        margin-right: auto;
        padding: 1rem 1.5rem;
    }

    a:hover {
        transform: scale(1.1);
        color: var(--primary);
    }

    #rotate {
        transform: rotate(180deg);
    }
</style>
