---
import video from "../assets/landingVideo.mp4";
import DownArrow from "../assets/downArrow.svg";
---

<section class="noSelect" id="landing">
	<div class="fadeInContent">
		<div class="divider"></div>
		<h1 class="mono">BANFF</h1>
		<div class="divider"></div>
		<h2 class="fadeInSubTitle mono">NATIONAL PARK</h2>
	</div>
	<div id="scrollIndicator">
		<div id="scrollText" class="mono">scroll</div>
		<div id="animatedLine"></div>
	</div>

	<video
		class="fadeInVideo"
		src={video}
		playsinline
		autoplay
		muted
		loop
		preload="true"
		width="3840"
		height="2160"></video>
</section>

<script>
	import { animate } from "motion";

	animate(".fadeInVideo", { opacity: 1 }, { delay: 2.25, duration: 2, ease: "easeInOut" });
	animate(
		".fadeInContent",
		{ opacity: 1, filter: 'blur(0px)' },
		{ delay: 0.25, duration: 1.5, ease: [ 0.550, 0.085, 0.640, 0.530 ] },
	);
	animate(
		".fadeInSubTitle",
		{ opacity: 1, filter: 'blur(0px)' },
		{ delay: 1.25, duration: 1, ease: [ 0.550, 0.085, 0.640, 0.530 ] },
	);
	animate(
        "#scrollText",
        { y: [-8, 0, -8] },
        { repeat: Infinity, repeatType: "loop", duration: 1.5 },
    );
	animate(
		"#scrollIndicator",
		{ opacity: 1 },
		{ delay: 3, duration: 2, ease: "easeInOut" },
	);

	

</script>

<style>
	.fadeInContent,
	.fadeInSubTitle,
	.fadeInVideo {
		opacity: 0;
	}

	.fadeInContent,
	.fadeInSubTitle {
		filter: blur(12px);
	}

	.divider, h1, h2{
		filter: drop-shadow(0 4px 4px rgb(0 0 0 / 0.6));
	}

	#scrollIndicator {
		position: absolute;
		bottom: 0%;
		opacity: 0%;
	}

	#animatedLine {
		margin: 0.5rem auto 0;
		width: 2px;
		height: 35px;
		background-color: #fcfcfc;
	}

	.divider {
		width: 100%;
		height: 3px;
		border-radius: 50%;
		background-color: #fcfcfc;
	}

	section {
		height: 100svh; /* full viewport height */
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
		color: #fcfcfc;
		background-color: rgb(3, 3, 3);
		/* border-bottom: 1px solid white; */
		filter: drop-shadow(0 4px 4px rgb(0 0 0 / 0.15));
	}

	video {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover; /* makes it behave like background-size: cover */
		object-position: center; /* keeps it centered */
		z-index: -5;
	}

	h1 {
		margin-top: 8px;
		font-size: var(--text-3xl);
	}

	h2 {
		margin-top: 0.5rem;
		font-size: var(--text-xl);
		letter-spacing: 4px;
		text-align: center;
	}

	/* targets devices width > 640 */
	@media screen and (max-width: 640px) {
		h1 {
			font-size: 5rem;
		}
		h2 {
			font-size: 1.25rem;
		}
	}
</style>
