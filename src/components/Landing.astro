---
import video from "../assets/bannervideo.mp4";
---

<section class="noSelect">
	<div class="fadeInContent">
		<div class="divider"></div>
		<h1 class="mono">BANFF</h1>
		<div class="divider"></div>
		<h2 class="fadeInSubTitle mono">NATIONAL PARK</h2>
	</div>
	<video
		class="fadeInVideo"
		src={video}
		playsinline
		autoplay
		muted
		loop
		preload="true"
		width="3840"
		height="2160"></video>
</section>

<script>
	import { animate } from "motion";
	animate(
		".fadeInContent",
		{ opacity: 1 },
		{ delay: 2, duration: 2, ease: "easeInOut" },
	);
	animate(
		".fadeInSubTitle",
		{ opacity: 1 },
		{ delay: 3, duration: 2, ease: "easeInOut" },
	);
	animate(".fadeInVideo", { opacity: 1 }, { duration: 3, ease: "easeInOut" });
</script>

<style>
	.fadeInContent,
	.fadeInSubTitle,
	.fadeInVideo {
		opacity: 0;
	}

	.divider {
		width: 100%;
		height: 3px;
		border-radius: 50%;
		background-color: #fcfcfc;
	}

	section {
		height: 100vh; /* full viewport height */
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
		color: #fcfcfc;
		background-color: #151515;
		/* border-bottom: 1px solid white; */
		filter: drop-shadow(0 4px 4px rgb(0 0 0 / 0.15));
	}

	video {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover; /* makes it behave like background-size: cover */
		object-position: center; /* keeps it centered */
		z-index: -5;
	}

	h1 {
		font-size: 7rem;
	}

	h2 {
		margin-top: 0.5rem;
		font-size: 1.75rem;
		letter-spacing: 4px;
		text-align: center;
	}

	/* targets devices width > 640 */
	@media screen and (max-width: 640px) {
		h1 {
			font-size: 5rem;
		}
		h2 {
			font-size: 1.25rem;
		}
	}
</style>
