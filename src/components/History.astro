---
import HistoryEntry from "./HistoryEntry.astro";

const history = [
	{
		year: 1883,
		text: "Canadian Pacific Railway (CPR) workers discover natural hot springs on Sulphur Mountain.",
	},
	{
		year: 1885,
		text: "The Canadian government establishes a 10-square-mile (26-square-km) reserve around the hot springs, creating the first iteration of a national park.",
	},
	{
		year: 1887,
		text: "The reserve is expanded and named the Rocky Mountains Park of Canada, officially becoming Canada's first national park.",
	},
	{
		year: 1888,
		text: "The iconic Banff Springs Hotel is built by the CPR, promoting the area as a luxury wilderness destination.",
	},
	{
		year: 1902,
		text: "The park's boundaries are significantly expanded to include areas around Lake Louise and other rivers.",
	},
	{
		year: 1911,
		text: "Pressure from commercial interests leads to a reduction in the park's size and Banff became accessible by autobile from Calgary.",
	},
	{
		year: 1916,
		text: "The Brewsters began offering motorcoach tours of Banff.",
	},
	{ year: 1920, text: "Access to Lake Louise by road was available." },
	{
		year: 1923,
		text: "The Banff-Windermere Road opens, connecting Banff to British Columbia.",
	},
	{
		year: 1930,
		text: "The National Parks Act is passed, fixing the park's boundaries at 6,697 km² (2,586 sq mi) and renaming it Banff National Park.",
	},
	{
		year: 1984,
		text: "Banff National Park is included in the UNESCO Canadian Rocky Mountain Parks World Heritage Site.",
	},
	{
		year: 1990,
		text: "The Town of Banff is incorporated, the first municipality within a Canadian National Park.",
	},
];
---

<section>
	<div class="historyContainer">
		<ol>
			{
				history.map((entry) => (
					<HistoryEntry year={entry.year} text={entry.text} />
				))
			}
		</ol>
	</div>
</section>

<style>
	.historyContainer{
		max-width: 1000px;
		margin-left: auto;
		margin-right: auto;
	}

	ol {
		border-left: 1px solid var(--foreground);
		padding-left: 2rem;
	}
</style>
