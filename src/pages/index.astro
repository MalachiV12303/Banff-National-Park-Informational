---
import Banner from "../components/Banner.astro";
import Reservations from "../components/Reservations.astro";
import History from "../components/History.astro";
import Title from "../components/Title.astro";
import Layout from "../layouts/Layout.astro";
import Landing from "../components/Landing.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
	<Landing />
	<Banner />
	<Title topWord="discover" bottomWord="banff" />
	<Reservations />
	<Title imageSelect={false} topWord="learn the" bottomWord="history" />
	<History />
	<Footer />
</Layout>

<script>
	import Lenis from "lenis";
	// Initialize Lenis
	const lenis = new Lenis();
	// Disable scrolling immediately
	const introAnimation = true;
	if (introAnimation) {
		lenis.stop();
		// Resume scroll after 4 seconds
		setTimeout(() => {
			lenis.start();
		}, 7000);
	}
	// Use requestAnimationFrame to continuously update the scroll
	function raf(time: number) {
		lenis.raf(time);
		requestAnimationFrame(raf);
	}
	requestAnimationFrame(raf);
</script>
