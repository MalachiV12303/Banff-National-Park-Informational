{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "types": ["astro/client"],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "astro.config.*",
    "env.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
