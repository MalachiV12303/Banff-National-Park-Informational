{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "preserve",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,                // don’t output compiled TS
    "isolatedModules": true,       // ensures compatibility with ESM
    "esModuleInterop": true,       // better interop with CJS/ESM packages
    "resolveJsonModule": true      // allow importing JSON if needed
  },
  "include": [
    "src",
    "astro.config.*",
    "env.d.ts",
    ".astro/types.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
